generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENCY_OWNER
  TEAM_MEMBER
}

enum SubscriptionPlan {
  FREE
  PRO
  AGENCY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

enum LeadStage {
  NEW_LEAD
  CONTACTED
  REPLIED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  CLOSED_WON
  CLOSED_LOST
}

enum OpportunityLevel {
  HIGH
  MEDIUM
  LOW
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum EmailProvider {
  RESEND
  SMTP
  SENDGRID
}

enum EmailStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  FAILED
  UNSUBSCRIBED
}

enum FollowUpStatus {
  SCHEDULED
  SENT
  CANCELLED
  SKIPPED
}

enum ActivityType {
  LEAD_CREATED
  LEAD_UPDATED
  STAGE_CHANGED
  NOTE_ADDED
  TAG_ADDED
  TAG_REMOVED
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  EMAIL_REPLIED
  AUDIT_COMPLETED
  PROPOSAL_SENT
  DEMO_GENERATED
  ASSIGNED
  CAMPAIGN_STARTED
}

enum Permission {
  LEADS_READ
  LEADS_WRITE
  CAMPAIGNS_READ
  CAMPAIGNS_WRITE
  PROPOSALS_READ
  PROPOSALS_WRITE
  ANALYTICS_READ
  TEAM_MANAGE
  BILLING_MANAGE
  SETTINGS_MANAGE
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  website     String?
  description String?  @db.Text
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  leads         Lead[]
  campaigns     Campaign[]
  proposals     Proposal[]
  discoveryJobs DiscoveryJob[]
  demos         WebsiteDemo[]
  tags          Tag[]
  subscription  Subscription?
  agencyProfile AgencyProfile?
  customCategories CustomCategory[]
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  role           UserRole  @default(TEAM_MEMBER)
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  accounts     Account[]
  sessions     Session[]
  permissions  UserPermission[]
  assignedLeads Lead[]       @relation("AssignedLeads")
  activities   Activity[]
  notes        Note[]
  campaigns    Campaign[]   @relation("CampaignCreator")
}

model UserPermission {
  id         String     @id @default(cuid())
  userId     String
  permission Permission
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  leadsUsedThisMonth   Int                @default(0)
  leadsResetAt         DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AgencyProfile {
  id                 String  @id @default(cuid())
  organizationId     String  @unique
  serviceDescription String? @db.Text
  offer              String? @db.Text
  pricing            String? @db.Text
  agencyInfo         String? @db.Text
  logoUrl            String?
  primaryColor       String? @default("#6366f1")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model CustomCategory {
  id             String @id @default(cuid())
  organizationId String
  name           String
  googlePlaceType String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

model DiscoveryJob {
  id             String   @id @default(cuid())
  organizationId String
  country        String
  state          String?
  city           String?
  district       String?
  area           String?
  category       String
  resultCount    Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]
}

model Lead {
  id                String           @id @default(cuid())
  organizationId    String
  discoveryJobId    String?
  assignedToId      String?
  businessName      String
  address           String?
  googleRating      Float?
  reviewCount       Int?
  website           String?
  phone             String?
  email             String?
  category          String
  latitude          Float?
  longitude         Float?
  googleMapsLink    String?
  googlePlaceId     String?
  stage             LeadStage        @default(NEW_LEAD)
  score             Int              @default(0)
  opportunityLevel  OpportunityLevel @default(MEDIUM)
  isUnsubscribed    Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  discoveryJob  DiscoveryJob? @relation(fields: [discoveryJobId], references: [id])
  assignedTo    User?         @relation("AssignedLeads", fields: [assignedToId], references: [id])
  audit         WebsiteAudit?
  tags          LeadTag[]
  notes         Note[]
  activities    Activity[]
  campaignLeads CampaignLead[]
  proposals     Proposal[]
  demos         WebsiteDemo[]

  @@index([organizationId, stage])
  @@index([organizationId, score])
  @@index([googlePlaceId])
}

model Tag {
  id             String @id @default(cuid())
  organizationId String
  name           String
  color          String @default("#6366f1")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        LeadTag[]

  @@unique([organizationId, name])
}

model LeadTag {
  leadId String
  tagId  String
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model Activity {
  id          String       @id @default(cuid())
  leadId      String
  userId      String?
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId, createdAt])
}

model WebsiteAudit {
  id                    String   @id @default(cuid())
  leadId                String   @unique
  hasWebsite            Boolean  @default(true)
  isSlow                Boolean  @default(false)
  isOutdated            Boolean  @default(false)
  poorMobile            Boolean  @default(false)
  seoProblems           Boolean  @default(false)
  missingContactForm    Boolean  @default(false)
  missingBooking        Boolean  @default(false)
  missingOnlineOrdering Boolean  @default(false)
  missingCTA            Boolean  @default(false)
  lowPerformance        Boolean  @default(false)
  performanceScore      Int?
  mobileScore           Int?
  seoScore              Int?
  aiReport              String?  @db.Text
  suggestions           String?  @db.Text
  salesOpportunities    String?  @db.Text
  rawData               Json?
  auditedAt             DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  createdById    String
  name           String
  subject        String?
  status         CampaignStatus @default(DRAFT)
  emailProvider  EmailProvider  @default(RESEND)
  serviceDescription String?    @db.Text
  offer          String?        @db.Text
  pricing        String?        @db.Text
  totalSent      Int            @default(0)
  totalOpened    Int            @default(0)
  totalClicked   Int            @default(0)
  totalReplied   Int            @default(0)
  totalBounced   Int            @default(0)
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User           @relation("CampaignCreator", fields: [createdById], references: [id])
  leads        CampaignLead[]
  followUps    FollowUp[]
}

model CampaignLead {
  id              String      @id @default(cuid())
  campaignId      String
  leadId          String
  personalizedMessage String? @db.Text
  editedMessage   String?     @db.Text
  emailStatus     EmailStatus @default(PENDING)
  sentAt          DateTime?
  deliveredAt     DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  repliedAt       DateTime?
  bouncedAt       DateTime?
  openCount       Int         @default(0)
  clickCount      Int         @default(0)
  trackingId      String      @unique @default(cuid())
  demoLink        String?

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  followUps FollowUp[]
  emailLogs EmailLog[]

  @@unique([campaignId, leadId])
  @@index([trackingId])
}

model FollowUp {
  id             String         @id @default(cuid())
  campaignId     String
  campaignLeadId String
  sequenceDay    Int
  message        String?        @db.Text
  status         FollowUpStatus @default(SCHEDULED)
  scheduledFor   DateTime
  sentAt         DateTime?
  createdAt      DateTime       @default(now())

  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignLead CampaignLead @relation(fields: [campaignLeadId], references: [id], onDelete: Cascade)

  @@index([scheduledFor, status])
}

model EmailLog {
  id             String      @id @default(cuid())
  campaignLeadId String
  event          EmailStatus
  metadata       Json?
  createdAt      DateTime    @default(now())

  campaignLead CampaignLead @relation(fields: [campaignLeadId], references: [id], onDelete: Cascade)
}

model Proposal {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String?
  clientName     String
  clientBusiness String
  projectScope   String   @db.Text
  packages       Json
  timeline       String?
  deliverables   String?  @db.Text
  terms          String?  @db.Text
  totalAmount    Float?
  pdfUrl         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])
}

model WebsiteDemo {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String?
  businessName   String
  category       String
  existingWebsite String?
  previewUrl     String?
  mockupData     Json?
  isPremium      Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])
}

model Unsubscribe {
  id             String   @id @default(cuid())
  email          String
  organizationId String
  reason         String?
  createdAt      DateTime @default(now())

  @@unique([email, organizationId])
}

model RateLimitLog {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
